# Public browser configuration. The Supabase anon key is designed to be public;
# authorization is enforced by Row Level Security in the database.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
CAGE_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
APP_URL=https://hub.cagemw.com

# Edge Function secrets (set with `supabase secrets set`; never expose in browser files)
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=CAGE Operations <operations@cagemw.com>
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
OPPORTUNITY_ALERT_TO=alexander@cagemw.com,ndapile@cagemw.com
OPPORTUNITY_MIN_SCORE=80
OPPORTUNITY_FEEDS=https://example.org/grants.rss,https://example.org/tenders.rss
